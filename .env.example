# Copy this file to .env and adjust if needed. The defaults work with `docker-compose up -d`.

NODE_ENV=development
PORT=5000

# The MongoDB started by docker-compose. For MongoDB Atlas use the mongodb+srv:// address it gives you.
MONGODB_URI=mongodb://localhost:27017/college_reviews

# If port 27017 is already taken on your machine (for example by a locally installed MongoDB),
# uncomment this and change the port in MONGODB_URI above to match.
# MONGO_PORT=27018

# Signs login tokens. Anyone who knows it can log in as anyone, so use a long random value outside
# your own machine (generate one with: openssl rand -hex 32). In production the server refuses to
# start with a value shorter than 32 characters or one that still starts with "change_me".
JWT_SECRET=change_me_to_a_long_random_string
# How long an access token lasts. Keep it short: it cannot be cancelled once issued, and the frontend
# renews it by itself with the refresh token, so nobody notices when it runs out.
JWT_EXPIRES_IN=15m

# How many days someone stays logged in without using the site (the refresh token's lifetime).
# Every use starts the period again. Default 7.
# REFRESH_TOKEN_EXPIRES_DAYS=7

# The address the frontend is served from (Vite's dev server by default).
# Several addresses can be listed, separated by commas.
CORS_ORIGIN=http://localhost:5173

# How many days action log entries are kept before MongoDB removes them
ACTION_LOG_RETENTION_DAYS=90

# --- Optional ---

# Only when the server runs behind a proxy or a hosting platform's load balancer (Render, Heroku, nginx):
# the number of proxies in front of it. Leave unset when running the server directly.
# TRUST_PROXY=1

# The admin account created by `npm run seed`. These are the defaults; set your own for anything shared.
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=Password@123

# Password of the sample accounts created by `npm run seed:demo`
# SEED_DEMO_PASSWORD=Password@123

# Picture uploads (profile pictures and college pictures) are stored with Cloudinary. All three values
# are on the Cloudinary dashboard under "API Keys". Set all three or none: without them the API runs
# normally and only the upload endpoints answer "not set up"; with only some, the server refuses to start.
# The API secret is a password. Keep it out of git and out of the frontend.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Password reset codes are emailed through an SMTP mail server. Set all four or none: without them the
# rest of the API works, and in development the code is written to the server log so the flow can still
# be tried. With only some, the server refuses to start.
# For Gmail: host smtp.gmail.com, port 465 (or 587), your Gmail address as the user, and an "app password"
# as the password (Google account > Security > 2-Step Verification > App passwords). Your normal Gmail
# password will not work. The password is a secret: keep it out of git.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=
# What recipients see as the sender. Defaults to "College Reviews <SMTP_USER>".
# MAIL_FROM=College Reviews <you@gmail.com>

# Keep-alive, for hosting plans that put an idle service to sleep (Render's free plan does after 15 minutes).
# When the server knows its public address it requests its own /health page on a timer so it stays awake.
# On Render the address is detected automatically, so nothing needs setting there. Locally it stays off.
# KEEP_ALIVE_URL=https://your-service.onrender.com
# Seconds between requests. The default is 600 (10 minutes). Set to 0 to turn keep-alive off.
# KEEP_ALIVE_INTERVAL_SECONDS=600

# Only if connecting to MongoDB Atlas fails with "querySrv ECONNREFUSED": some VPNs and DNS proxies
# refuse the lookup that mongodb+srv:// addresses need. This makes the server ask these resolvers instead.
# DNS_SERVERS=8.8.8.8,1.1.1.1

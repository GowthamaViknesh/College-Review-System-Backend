# Copy this file to .env and adjust if needed. The defaults work with `docker-compose up -d`.

NODE_ENV=development
PORT=5000

# The MongoDB started by docker-compose. For MongoDB Atlas use the mongodb+srv:// address it gives you.
MONGODB_URI=mongodb://localhost:27017/college_reviews

# If port 27017 is already taken on your machine (for example by a locally installed MongoDB),
# uncomment this and change the port in MONGODB_URI above to match.
# MONGO_PORT=27018

# Signs login tokens. Anyone who knows it can log in as anyone, so use a long random value outside
# your own machine (generate one with: openssl rand -hex 32). In production the server refuses to
# start with a value shorter than 32 characters or one that still starts with "change_me".
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# The address the frontend is served from (Vite's dev server by default)
CORS_ORIGIN=http://localhost:5173

# How many days action log entries are kept before MongoDB removes them
ACTION_LOG_RETENTION_DAYS=90

# --- Optional ---

# The admin account created by `npm run seed`. These are the defaults; set your own for anything shared.
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=Password@123

# Password of the sample accounts created by `npm run seed:demo`
# SEED_DEMO_PASSWORD=Password@123

# Only if connecting to MongoDB Atlas fails with "querySrv ECONNREFUSED": some VPNs and DNS proxies
# refuse the lookup that mongodb+srv:// addresses need. This makes the server ask these resolvers instead.
# DNS_SERVERS=8.8.8.8,1.1.1.1
